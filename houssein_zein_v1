'''
. Create 3 variables to store
    - A person's name (string) 
    - Their age (integer) 
    - Their favorite fruit (string) 
'''

first_name=""

while not first_name.isalpha():
    first_name = input("Enter The First Name, it must be only alphabetic: \n")
    if not first_name.isalpha():
        print("Invalid username ❌ (letters only allowed)\n")

print(f"Valid username ✅: {first_name}")

print("==========================================")
last_name=""

# get lastname in alpha not digit
while not last_name.isalpha():
    last_name = input("Enter The last Name, it must be only alphabetic:\n")
    if not last_name.isalpha():
        print("Invalid lastname ❌ (letters only allowed)\n")

print(f"Valid username ✅: {last_name}")

print("==========================================")

age=0
while True:
    age = input("Enter your age, it must be between 0 and 100:\n")

    # check if input is digits only
    if age.isdigit():
        age= int(age)

        # check if age < 64
        if age < 100 and age> 0:
            print(f"Valid age:✅ {age}")
            break
        else:
            print("❌ Age must be between a and 100\n.")
    else:
        print("❌ Invalid input (digits only).\n")

print("==========================================")

